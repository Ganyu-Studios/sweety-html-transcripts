{
  "name": "sweety-html-transcripts",
  "version": "0.4.0",
  "description": "A sweety formatted html transcript generator for discord bots.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/Ganyu-Studios/sweety-html-transcripts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "prettier --write --cache . && eslint --cache --fix .",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "vite": "vite",
    "test": "tsx --test tests/unit/*.test.ts",
    "generate:seyfert": "tsx ./tests/generators/seyfert-generate.ts",
    "generate:djs": "tsx ./tests/generators/djs-generate.ts",
    "update-components": "pnpm update @penwin/*@latest"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "pnpm lint"
    ],
    "*.{json,md,yml,yaml}": [
      "pnpm lint"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.js",
      "require": "./dist/adapters/*.js",
      "types": "./dist/adapters/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganyu-Studios/sweety-html-transcripts.git"
  },
  "keywords": [
    "seyfert",
    "discord.js",
    "seyfert-transcripts",
    "discordjs-transcripts",
    "sweety-html-transcripts",
    "html-transcripts",
    "discord-transcripts"
  ],
  "author": "Ganyu Studios",
  "license": "GNU GPLv3",
  "contributors": [
    {
      "name": "JustEvil",
      "url": "https://github.com/EvilG-MC"
    }
  ],
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@penwin/discord-components-core": "4.5.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "seyfert": "5.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@penwin/discord-components-react-render": "^4.5.0",
    "discord-api-types": "^0.38.55",
    "discord-markdown-parser": "~1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2"
  },
  "peerDependencies": {
    "discord.js": ">=14.25.1",
    "seyfert": ">=4.0.0-0"
  },
  "overrides": {
    "react": "$react"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
