{
  "name": "sweety-html-transcripts",
  "version": "1.2.1",
  "description": "Fast, library-agnostic HTML transcripts for Discord bots (seyfert, discord.js, or plain REST).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/Ganyu-Studios/sweety-html-transcripts",
  "scripts": {
    "build": "tsc6 -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "prettier --write --cache . && eslint --cache --fix .",
    "typecheck": "tsc6 -p tsconfig.eslint.json",
    "vite": "vite",
    "test": "tsx --test tests/unit/*.test.ts tests/unit/*.test.tsx",
    "generate:seyfert": "tsx ./tests/generators/seyfert-generate.ts",
    "generate:djs": "tsx ./tests/generators/djs-generate.ts",
    "update-components": "pnpm update @penwin/discord-components-core@latest",
    "generate:sample": "tsx ./tests/generators/sample-generate.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "pnpm lint"
    ],
    "*.{json,md,yml,yaml}": [
      "pnpm lint"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.js",
      "require": "./dist/adapters/*.js",
      "types": "./dist/adapters/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganyu-Studios/sweety-html-transcripts.git"
  },
  "keywords": [
    "seyfert",
    "discord.js",
    "discord-api",
    "transcripts",
    "html-transcripts",
    "discord-transcripts",
    "sweety-html-transcripts"
  ],
  "author": "Ganyu Studios",
  "license": "GNU GPLv3",
  "contributors": [
    {
      "name": "JustEvil",
      "url": "https://github.com/EvilG-MC"
    }
  ],
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@penwin/discord-components-core": "4.7.1",
    "@types/node": "^26.6.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "seyfert": "6.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "discord-api-types": "^0.38.60",
    "discord-markdown-parser": "~1.3.1",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2"
  },
  "peerDependencies": {
    "@penwin/discord-components-core": "^4.6.0",
    "sharp": ">=0.33.0",
    "seyfert": ">=5.0.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "peerDependenciesMeta": {
    "@penwin/discord-components-core": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "seyfert": {
      "optional": true
    }
  }
}
