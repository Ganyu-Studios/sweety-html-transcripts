{
  "name": "sweety-html-transcripts",
  "version": "0.2.6",
  "description": "A sweety formatted html transcript generator for discord bots.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/Ganyu-Studios/sweety-html-transcripts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "prettier --write --cache . && eslint --cache --fix .",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "vite": "vite",
    "test:seyfert": "tsx ./tests/seyfert-generate.ts",
    "test:djs": "tsx ./tests/djs-generate.ts",
    "update-components": "pnpm update @penwin/*@latest"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.js",
      "require": "./dist/adapters/*.js",
      "types": "./dist/adapters/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganyu-Studios/sweety-html-transcripts.git"
  },
  "keywords": [
    "seyfert",
    "discord.js",
    "seyfert-transcripts",
    "discordjs-transcripts",
    "sweety-html-transcripts",
    "html-transcripts",
    "discord-transcripts"
  ],
  "author": "Ganyu Studios",
  "license": "GNU GPLv3",
  "contributors": [
    {
      "name": "JustEvil",
      "url": "https://github.com/EvilG-MC"
    }
  ],
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@penwin/discord-components-core": "^4.3.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "seyfert": "5.0.1-dev-29307366727.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@derockdev/discord-components-core": "^3.6.1",
    "@penwin/discord-components-react-render": "^4.3.8",
    "discord-api-types": "^0.38.51",
    "discord-markdown-parser": "~1.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2"
  },
  "peerDependencies": {
    "discord.js": ">=14.25.1",
    "seyfert": ">=4.0.0-0"
  },
  "overrides": {
    "react": "$react"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
