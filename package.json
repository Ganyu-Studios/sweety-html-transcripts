{
  "name": "sweety-html-transcripts",
  "version": "0.2.6",
  "description": "A sweety formatted html transcript generator for discord bots.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/Ganyu-Studios/sweety-html-transcripts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "prettier --write --cache . && eslint --cache --fix .",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "vite": "vite",
    "test": "tsx --test tests/unit/*.test.ts",
    "generate:seyfert": "tsx ./tests/generators/seyfert-generate.ts",
    "generate:djs": "tsx ./tests/generators/djs-generate.ts",
    "update-components": "pnpm update @penwin/*@latest"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.js",
      "require": "./dist/adapters/*.js",
      "types": "./dist/adapters/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganyu-Studios/sweety-html-transcripts.git"
  },
  "keywords": [
    "seyfert",
    "discord.js",
    "seyfert-transcripts",
    "discordjs-transcripts",
    "sweety-html-transcripts",
    "html-transcripts",
    "discord-transcripts"
  ],
  "author": "Ganyu Studios",
  "license": "GNU GPLv3",
  "contributors": [
    {
      "name": "JustEvil",
      "url": "https://github.com/EvilG-MC"
    }
  ],
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@penwin/discord-components-core": "^4.3.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "seyfert": "5.0.1-dev-29307366727.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@derockdev/discord-components-core": "^3.6.1",
    "@penwin/discord-components-react-render": "^4.3.8",
    "discord-api-types": "^0.38.53",
    "discord-markdown-parser": "~1.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2"
  },
  "peerDependencies": {
    "discord.js": ">=14.25.1",
    "seyfert": ">=4.0.0-0"
  },
  "overrides": {
    "react": "$react"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
