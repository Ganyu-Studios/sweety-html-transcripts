# Settings for the manual generators (pnpm generate:seyfert / generate:djs).
# Copy to .env and fill in. .env is gitignored.

# Bot token and the channel to export.
TOKEN=
CHANNEL=
DEBUG=false

# How many of the newest messages to fetch. -1 fetches the whole channel.
LIMIT=30

# true renders on the server (mode: 'server', declarative shadow DOM).
# Needs @penwin/discord-components-core >= 4.6.0 installed.
SSR=false

# false writes the HTML to OUTPUT instead of sending it to CHANNEL.
SEND_TRANSCRIPT_TEST=true
OUTPUT=./index.html

# Render options.
THEME=dark
LOCALE=en

# Only for pnpm generate:sample: load the component bundle from a local core build.
# SAMPLE_CDN=http://localhost:4321/core
