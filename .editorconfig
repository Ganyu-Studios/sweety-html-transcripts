# https://editorconfig.org
# Mirrors .prettierrc.json so editors format the same way prettier does.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 120

# Trailing whitespace is meaningful in markdown (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
